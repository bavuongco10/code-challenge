# Optional: without DATABASE_URL the app uses in-memory PGlite. `neon env pull` writes these to .env.local (loaded by `pnpm start` and drizzle-kit).
# Any Postgres works: switching provider = changing these URLs.
DATABASE_URL=            # pooled (app traffic)
DATABASE_URL_UNPOOLED=   # direct (migrations); falls back to DATABASE_URL
PORT=3000
